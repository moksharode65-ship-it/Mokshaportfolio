# Copy this file to .env and fill in real values.
# Never commit the real .env file — it is already in .gitignore.

# Optional: URL to your intro / showreel video (YouTube, Vimeo, or a hosted
# .mp4). If unset, the "Play Intro" button shows a short reminder instead.
VITE_INTRO_VIDEO_URL=

# Optional: endpoint the contact form (if you add one) should POST to,
# e.g. a Formspree endpoint, a serverless function, or your own API.
VITE_CONTACT_FORM_ENDPOINT=